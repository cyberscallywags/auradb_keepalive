# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Document every environment variable your project reads, with a safe default
# or a clear placeholder. Keep secrets out of version control.

# --- Core ---
LOG_LEVEL=INFO

# --- External service (example) ---
EXAMPLE_URL=https://api.example.com
EXAMPLE_TOKEN=changeme

# --- Feature flags (example) ---
ENABLE_FEATURE_X=false
